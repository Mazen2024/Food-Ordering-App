// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Schema For Users Table 
model Users {
  id            String          @id @default(cuid())
  email         String          @unique
  password      String
  name          String
  image         String?
  phone         String?
  streetaddress String?
  postalcode    String?
  city          String?
  country       String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  /// One To Many Relation
  OrderProducts OrderProducts[]
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         Users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/// Schema For Orders Table 
model Orders {
  id            String          @id @default(cuid())
  paid          Boolean         @default(false)
  subtotal      Float
  deliveryfees  Float
  total         Float
  phone         String
  streetaddress String
  postalcode    String
  city          String
  country       String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  products      OrderProducts[]
}

/// Schema For OrderProducts Table 
model OrderProducts {
  id         String   @id @default(cuid())
  quantity   Int      @default(1)
  /// One To Many Relation
  orders     Orders   @relation(fields: [ordersId], references: [id])
  ordersId   String
  /// User ID is Optional In Case Of Guest User Not Authenticated
  users      Users?   @relation(fields: [usersId], references: [id])
  usersId    String?
  /// One To Many Relation
  products   products @relation(fields: [productsId], references: [id])
  productsId String
}

/// Schema For Categories Table 
model Categories {
  id       String     @id @default(cuid())
  nameAR   String
  nameEN   String
  order    Int        @default(autoincrement())
  /// One To Many Relation
  products products[]
}

/// Schema For Products Table 
model products {
  id            String          @id @default(cuid())
  nameAR        String
  nameEN        String
  descriptionAR String
  descriptionEN String
  image         String
  order         Int             @default(autoincrement())
  basePrice     Float
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  /// One To Many Relation
  sizes         Sizes[]
  extras        Extras[]
  categories    Categories      @relation(fields: [categoriesId], references: [id])
  categoriesId  String
  // One To Many Relation
  OrderProducts OrderProducts[]
}

/// Schema For Sizes Table & Relation With Products 
model Sizes {
  id         String   @id @default(cuid())
  name       ProSizes
  price      Float    @default(1)
  products   products @relation(fields: [productsId], references: [id])
  productsId String
}

/// Schema For Extras Table & Relation With Products 
model Extras {
  id         String    @id @default(cuid())
  name       ProExtras
  price      Float     @default(1)
  products   products  @relation(fields: [productsId], references: [id])
  productsId String
}

/// Enum For Sizes Values
enum ProSizes {
  SMALL
  MEDIUM
  LARGE
  EXTRA_LARGE
}

/// Enum For Extras Values
enum ProExtras {
  TOMATO
  CHEESE
  ONION
  MEAT
  PEPPER
}
